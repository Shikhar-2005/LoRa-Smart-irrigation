/*
 * LoRa Smart Irrigation - Gateway Credentials
 *
 * Copy this file to credentials.h and fill in your real values.
 * credentials.h is git-ignored and will NOT be pushed to GitHub.
 */

#ifndef CREDENTIALS_H
#define CREDENTIALS_H

// WiFi network
#define WIFI_SSID       "YOUR_WIFI_SSID"
#define WIFI_PASSWORD   "YOUR_WIFI_PASSWORD"

// Cloud server URL (where flask_app.py is running)
// Local development: "http://192.168.1.100:5000"
// PythonAnywhere:    "https://yourusername.pythonanywhere.com"
#define SERVER_URL      "http://192.168.1.100:5000"

// API endpoint for sensor data
#define API_PREDICT_URL SERVER_URL "/api/predict"

#endif // CREDENTIALS_H
