# LoRa Smart Irrigation - Environment Variables
# Copy this file to .env and fill in your real values.
# .env is git-ignored and never pushed to GitHub.

# Telegram Bot (get from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN
TELEGRAM_CHAT_ID=YOUR_CHAT_ID

# OpenWeatherMap (free tier: https://openweathermap.org/api)
OWM_API_KEY=YOUR_OWM_API_KEY
